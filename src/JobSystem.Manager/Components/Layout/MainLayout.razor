@inherits LayoutComponentBase
@inject IHostEnvironment Environment

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="alert alert-danger">
                        <h4>An error occurred</h4>
                        <p><strong>Message:</strong> @GetFullErrorMessage(ex)</p>
                        @if (Environment.IsDevelopment())
                        {
                            <details>
                                <summary>Stack Trace</summary>
                                <pre style="white-space: pre-wrap; font-size: 0.85em;">@ex.StackTrace</pre>
                            </details>
                        }
                        <button class="btn btn-outline-danger mt-2" @onclick="Recover">Try Again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private void Recover()
    {
        _errorBoundary?.Recover();
    }

    private static string GetFullErrorMessage(Exception ex)
    {
        var messages = new List<string>();
        var current = ex;
        while (current != null)
        {
            messages.Add(current.Message);
            current = current.InnerException;
        }
        return string.Join(" → ", messages);
    }
}
